# Secrets: never commit the real .env (use .env.example)
.env
.env.*
!.env.example

# Local-only data pack (database + product images)
data/
*.db
*.sqlite
*.sqlite3

# Python
.venv/
venv/
__pycache__/
*.pyc

# Node / Vite
node_modules/
frontend/dist/
*.log

# Audit-trail temp/backup files (audit_trail.json itself IS committed)
output/*.tmp
output/audit_trail.corrupt-*.json

# Local working files not part of the submission
*.docx
.DS_Store
.claude/
