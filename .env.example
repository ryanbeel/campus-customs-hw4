# Copy this file to .env and fill in your own values. Never commit .env.
# Portkey API key (routes requests to the OpenAI model)
PORTKEY_API_KEY=your-portkey-api-key-here
# Model name used through Portkey
OPENAI_MODEL=gpt-5.6-luna
# Optional: secret for signing login tokens. Uncomment and set a long random string
# (e.g. from: python3 -c "import secrets; print(secrets.token_hex(32))").
# If unset, a random one is generated each time the server starts.
# SESSION_SECRET=
